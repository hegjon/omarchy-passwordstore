#!/bin/bash

# Set up and sync a password store for the Omarchy widget.
#
#   passwordstore-setup <command> [options] [packages…]
#
# Commands. Every one prints a single JSON object on stdout; problems are
# reported inside it ({"error": "…"}) with exit 0 so the card can always show
# a reason, and only a bad invocation exits non-zero.
#
#   status         what is installed, where the store is, whether it is usable
#   gpg-list       the secret keys gpg knows about
#   gpg-generate   `gpg --full-generate-key` in a terminal, then gpg-list
#   gpg-inspect    classify a key file as public or private; with no --file,
#                  suggest default paths under ~ / Downloads / Documents
#   gpg-import     `gpg --import --file PATH`, then gpg-list
#   install        `omarchy pkg add PKG…` in a terminal, then status
#   init           `pass init --gpg-id ID` (refuses to re-key an existing
#                  store unless --reencrypt is given)
#   sync-status    the configured backend and whether it looks ready
#   sync-setup     first-time wiring of the backend: git remote and first
#                  push (or fetch of an existing remote), rclone's first copy
#   sync-pull      bring the remote's changes into the store
#   sync-push      send the store's changes to the remote
#
# Options:
#   --vault ID             which vault's settings to use (else activeVaultId,
#                          else the first vault, else the widget's own keys)
#   --store DIR            the store; else the vault's storeDir, else
#                          $PASSWORD_STORE_DIR, else ~/.password-store
#   --backend NAME         local | git | rclone | custom
#   --git-remote URL       git: the remote to push to
#   --rclone-remote PATH   rclone: remote:path
#   --rclone-mode MODE     rclone: copy (default) | sync
#   --push-cmd CMD         custom: command run after a change
#   --pull-cmd CMD         custom: command run when the card opens
#   --gpg-id ID            init: key id, fingerprint or e-mail; repeat it to
#                          encrypt for several recipients (a shared vault)
#   --file PATH            gpg-import / gpg-inspect: the key file
#   --confirm              sync-setup: allow the first upload of a non-empty store
#   --reencrypt            init: allow `pass init` over an existing store
#   --quiet                sync-pull/push: never notify
#
# An option that is not given is read from the vault's record in the widget's
# entry in shell.json (`vaults`, chosen by --vault or `activeVaultId`), with
# the entry's own keys as the fallback for a one-store install that predates
# vaults. So `passwordstore-setup sync-push` in a terminal does what the card
# does.
#
# Nothing here handles a secret. gpg and pass prompt through pinentry; git
# and rclone use their own credential stores; a passphrase is never asked for
# and never passed on. Anything that may need a password at a tty (key
# generation, package installs, the first git push) runs in a terminal and is
# waited on from outside.

set -uo pipefail

readonly PLUGIN_ID="hegjon.passwordstore"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-passwordstore"
readonly SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"

usage() { sed -n '3,54p' "$0" | sed 's/^# \{0,1\}//'; }

command=${1:-}
[[ -n $command ]] || { usage >&2; exit 2; }
shift

vault_id=""
store=""
backend=""
git_remote=""
rclone_remote=""
rclone_mode=""
push_cmd=""
pull_cmd=""
gpg_ids=()
key_file=""
confirm=false
pinentry_enable=false
pinentry_disable=false
reencrypt=false
quiet=false
positional=()

while [[ $# -gt 0 ]]; do
  case $1 in
    --vault) vault_id=${2:-}; shift 2 ;;
    --store) store=${2:-}; shift 2 ;;
    --backend) backend=${2:-}; shift 2 ;;
    --git-remote) git_remote=${2:-}; shift 2 ;;
    --rclone-remote) rclone_remote=${2:-}; shift 2 ;;
    --rclone-mode) rclone_mode=${2:-}; shift 2 ;;
    --push-cmd) push_cmd=${2:-}; shift 2 ;;
    --pull-cmd) pull_cmd=${2:-}; shift 2 ;;
    --gpg-id) gpg_ids+=("${2:-}"); shift 2 ;;
    --file) key_file=${2:-}; shift 2 ;;
    --confirm) confirm=true; shift ;;
    --enable) pinentry_enable=true; shift ;;
    --disable) pinentry_disable=true; shift ;;
    --reencrypt) reencrypt=true; shift ;;
    --quiet) quiet=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; positional+=("$@"); break ;;
    -*) echo "passwordstore-setup: unknown option: $1" >&2; exit 2 ;;
    *) positional+=("$1"); shift ;;
  esac
done

# --- output ----------------------------------------------------------------

emit() { # jq args… — prints one compact object
  jq -cn "$@"
}

emit_error() { # message
  jq -cn --arg e "$1" '{error: $e}'
  exit 0
}

# --- settings from shell.json -----------------------------------------------

# The widget's bar entry is where `omarchy bar set` and the card write
# settings. Vaults are the `vaults` array on it (or, set without --json, a
# string holding that array); a vault's own keys win over the entry's, which
# only remain for a one-store install from before vaults existed.
ENTRY_JSON='{}'
if [[ -r $SHELL_JSON ]]; then
  ENTRY_JSON=$(jq -c --arg id "$PLUGIN_ID" '
    [.bar.layout // {} | (.left // [])[], (.center // [])[], (.right // [])[]]
    | map(select(type == "object" and .id == $id))
    | first // {}
  ' "$SHELL_JSON" 2>/dev/null) || ENTRY_JSON='{}'
  [[ $ENTRY_JSON == \{* ]] || ENTRY_JSON='{}'
fi
readonly ENTRY_JSON

VAULTS_JSON=$(jq -c '
  (.vaults // []) as $v
  | (if ($v | type) == "string" then (try ($v | fromjson) catch []) else $v end)
  | if type == "array" then map(select(type == "object" and (.id | type) == "string")) else [] end
' <<<"$ENTRY_JSON" 2>/dev/null) || VAULTS_JSON='[]'
readonly VAULTS_JSON

# The vault this run is about: --vault, else activeVaultId, else the first.
VAULT_JSON=$(jq -c --arg id "$vault_id" --arg active "$(jq -r '.activeVaultId // "" | tostring' <<<"$ENTRY_JSON")" '
  if $id != "" then (map(select(.id == $id)) | first // null)
  else ((map(select(.id == $active)) | first) // (first // {}))
  end
' <<<"$VAULTS_JSON" 2>/dev/null) || VAULT_JSON='{}'
if [[ $VAULT_JSON == null ]]; then
  # A named vault that is not on record: fine for a legacy single store
  # (the card names it "personal" before the first save), an error otherwise.
  if [[ $(jq length <<<"$VAULTS_JSON") -gt 0 ]]; then
    jq -cn --arg id "$vault_id" '{error: ("No vault named " + $id)}'
    exit 0
  fi
  VAULT_JSON='{}'
fi
readonly VAULT_JSON
vault_id=$(jq -r '.id // ""' <<<"$VAULT_JSON")
[[ -n $vault_id ]] || vault_id=personal
vault_name=$(jq -r '.name // ""' <<<"$VAULT_JSON")
[[ -n $vault_name ]] || vault_name=Personal

# Booleans come back as "true"/"false" whichever way they were stored, and a
# missing key as nothing at all.
config_setting() { # key
  jq -er --arg key "$1" --argjson entry "$ENTRY_JSON" '
    if has($key) and .[$key] != null then (.[$key] | tostring)
    elif ($entry | has($key)) and $entry[$key] != null then ($entry[$key] | tostring)
    else empty end
  ' <<<"$VAULT_JSON" 2>/dev/null
}

setting_or() { # current, key, default
  if [[ -n $1 ]]; then printf '%s' "$1"; return; fi
  local v
  v=$(config_setting "$2") && [[ -n $v ]] && { printf '%s' "$v"; return; }
  printf '%s' "$3"
}

is_true() { [[ ${1,,} != false && $1 != 0 && -n $1 ]]; }

# --- the store --------------------------------------------------------------

store=$(setting_or "$store" storeDir "")
[[ -n $store ]] || store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
store=${store/#\~/$HOME}
store=${store%/}
export PASSWORD_STORE_DIR=$store

backend=$(setting_or "$backend" syncBackend local)
git_remote=$(setting_or "$git_remote" gitRemote "")
rclone_remote=$(setting_or "$rclone_remote" rcloneRemote "")
rclone_mode=$(setting_or "$rclone_mode" rcloneMode copy)
push_cmd=$(setting_or "$push_cmd" syncPushCmd "")
pull_cmd=$(setting_or "$pull_cmd" syncPullCmd "")
case $backend in local|git|rclone|custom) ;; *) backend=local ;; esac
[[ $rclone_mode == sync ]] || rclone_mode=copy

# The entry count is what "empty store" means everywhere below.
store_entries() {
  [[ -d $store ]] || { echo 0; return; }
  find "$store" \( -name .git -o -name .extensions \) -prune -o -type f -name '*.gpg' -print 2>/dev/null | wc -l
}

store_gpg_ids() { # one per line, blank lines dropped
  [[ -r $store/.gpg-id ]] || return 0
  grep -v '^[[:space:]]*$' "$store/.gpg-id" | sed 's/[[:space:]]*$//'
}

store_gpg_ids_json() {
  store_gpg_ids | jq -R . | jq -cs .
}

# --- notifications ----------------------------------------------------------

notify() { # urgency, summary, body
  $quiet && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  # Bodies are markup to notification daemons; helper output and remote names
  # are escaped rather than rendered.
  local body=${3//&/\&amp;}
  body=${body//</\&lt;}
  body=${body//>/\&gt;}
  notify-send --app-name "Password Store" --urgency "$1" --expire-time 6000 \
    "$2" "$body" 2>/dev/null || true
}

# --- a terminal, waited on ------------------------------------------------

# Run a script in a floating terminal and wait for it. The terminal is
# detached (a shell restart must not kill a half-done key generation), so the
# wrapper reports its exit status through a file this side polls. With a tty
# attached the window stays open until a key is pressed so output can be read;
# under test (PASSWORDSTORE_TERMINAL) there is no tty and it just returns.
run_in_terminal() { # title, script
  local title=$1 script=$2 dir marker wrapped waited=0 status
  dir=$(mktemp -d) || return 1
  marker=$dir/status
  # Write the status file after the optional "press any key" so the overlay
  # (which hides while we wait) does not come back and steal keys from this
  # terminal. Tests set PASSWORDSTORE_TERMINAL with no tty, so they skip the
  # pause and return as soon as the script exits.
  wrapped=$(printf 'bash -c %q; s=$?; if [[ -t 0 ]]; then echo; read -rsn1 -p "Press any key to close"; fi; printf %%s "$s" > %q; exit "$s"' \
    "$script" "$marker")
  if [[ -n ${PASSWORDSTORE_TERMINAL:-} ]]; then
    # Test hook: a command that runs `bash -c SCRIPT` synchronously.
    # shellcheck disable=SC2086  # word-split on purpose
    $PASSWORDSTORE_TERMINAL bash -c "$wrapped" </dev/null >/dev/null 2>&1
  elif command -v uwsm-app >/dev/null 2>&1 && command -v xdg-terminal-exec >/dev/null 2>&1; then
    # The org.omarchy.terminal app id is what Hyprland's rules float and center.
    setsid -f uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="$title" \
      -e bash -c "$wrapped" </dev/null >/dev/null 2>&1
  elif command -v omarchy-launch-terminal >/dev/null 2>&1; then
    setsid -f omarchy-launch-terminal bash -c "$wrapped" </dev/null >/dev/null 2>&1
  else
    rm -rf "$dir"
    return 127
  fi
  while [[ ! -s $marker ]]; do
    sleep 0.5
    waited=$(( waited + 1 ))
    # An hour: long enough for a key generation with a slow entropy pool.
    (( waited < 7200 )) || { rm -rf "$dir"; return 124; }
  done
  status=$(<"$marker")
  rm -rf "$dir"
  [[ $status =~ ^[0-9]+$ ]] || status=1
  return "$status"
}

# --- gpg --------------------------------------------------------------------

have() { command -v "$1" >/dev/null 2>&1; }

# Keys as JSON: [{id, fpr, uid, created, expires, expired, revoked, secret}],
# secret keys first. Public keys are listed too: a shared vault is encrypted
# for teammates whose secret keys are, rightly, not on this machine.
# gpg's colon format escapes ':' in a uid as \x3a; that is the only escape it
# uses, so it is the only one undone here.
gpg_colons_tsv() { # secret flag, gpg listing option
  gpg --batch --with-colons "$2" 2>/dev/null | awk -F: -v secret="$1" '
    function emit() { printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", id, fpr, uid, created, expires, validity, secret }
    $1 == "sec" || $1 == "pub" { if (id != "") emit(); id = $5; validity = $2; created = $6; expires = $7; fpr = ""; uid = "" }
    $1 == "fpr" && id != "" && fpr == "" { fpr = $10 }
    $1 == "uid" && id != "" && uid == "" { uid = $10 }
    END { if (id != "") emit() }
  '
}

gpg_list_json() {
  have gpg || { echo '[]'; return; }
  { gpg_colons_tsv 1 --list-secret-keys; gpg_colons_tsv 0 --list-keys; } \
  | sed 's/\\x3a/:/g' | jq -R -c 'split("\t") | {
      id: .[0], fpr: .[1], uid: .[2],
      created: (.[3] | if . == "" then null else tonumber end),
      expires: (.[4] | if . == "" then null else tonumber end),
      expired: (.[5] == "e"), revoked: (.[5] == "r"), secret: (.[6] == "1")
    }' | jq -cs '
      group_by(.fpr) | map(.[0] + {secret: (map(.secret) | any)})
      | sort_by((.secret | not), (.uid | ascii_downcase))'
}

# Does a secret key exist for the id (key id, fingerprint or e-mail)?
have_secret_key() { # id
  have gpg || return 1
  gpg --batch --list-secret-keys -- "$1" >/dev/null 2>&1
}

# User-dir inside $HOME only (tests redirect HOME; xdg-user-dir would
# otherwise still point at the real seat).
xdg_home_dir() { # DOWNLOAD|DOCUMENTS|DESKTOP
  local name=$1 val=""
  if command -v xdg-user-dir >/dev/null 2>&1; then
    val=$(xdg-user-dir "$name" 2>/dev/null) || val=""
  fi
  if [[ -n $val && $val == "$HOME"/* ]]; then
    printf '%s' "$val"
    return
  fi
  case $name in
    DOWNLOAD) printf '%s' "$HOME/Downloads" ;;
    DOCUMENTS) printf '%s' "$HOME/Documents" ;;
    DESKTOP) printf '%s' "$HOME/Desktop" ;;
  esac
}

home_rel() {
  local p=$1
  # shellcheck disable=SC2088  # a literal ~ for display is the point
  if [[ $p == "$HOME"/* ]]; then printf '~/%s' "${p#"$HOME"/}"
  else printf '%s' "$p"
  fi
}

# secret | public | unknown | missing. Armor headers first so a file can be
# classified without talking to gpg (and without importing it).
key_file_kind() {
  local f=$1 sz=0 colons=""
  [[ -f $f && -r $f ]] || { echo missing; return; }
  sz=$(wc -c < "$f" 2>/dev/null) || sz=0
  (( sz > 0 && sz < 5000000 )) || { echo unknown; return; }
  if grep -a -q -m1 -E 'BEGIN PGP (PRIVATE|SECRET) KEY BLOCK' "$f"; then echo secret; return; fi
  if grep -a -q -m1 'BEGIN PGP PUBLIC KEY BLOCK' "$f"; then echo public; return; fi
  if have gpg; then
    colons=$(gpg --batch --show-keys --with-colons -- "$f" 2>/dev/null) || colons=""
    if grep -q '^sec:' <<<"$colons"; then echo secret; return; fi
    if grep -q '^pub:' <<<"$colons"; then echo public; return; fi
  fi
  echo unknown
}

key_file_uid() {
  have gpg || return 0
  gpg --batch --show-keys --with-colons -- "$1" 2>/dev/null \
    | awk -F: '$1=="uid"{gsub(/\\x3a/,":",$10); print $10; exit}'
}

# One JSON object on stdout, or nothing if the file is not an importable key.
scan_key_file() {
  local f=$1 kind uid
  [[ -f $f && -r $f ]] || return 0
  case ${f##*/} in
    pubring.kbx|pubring.gpg|secring.gpg|trustdb.gpg|random_seed|*.rev) return 0 ;;
  esac
  kind=$(key_file_kind "$f")
  [[ $kind == secret || $kind == public ]] || return 0
  uid=$(key_file_uid "$f" || true)
  jq -cn --arg path "$(home_rel "$f")" --arg kind "$kind" --arg uid "$uid" \
    '{path: $path, kind: $kind, uid: $uid}'
}

gpg_inspect_file() { # path as typed
  local typed=$1 raw kind uid
  [[ -n $typed ]] || emit_error "Which file? (--file PATH)"
  raw=${typed/#\~/$HOME}
  if [[ ! -e $raw ]]; then
    emit --arg path "$(home_rel "$raw")" '{path: $path, exists: false, kind: "missing", uid: ""}'
    return
  fi
  [[ -f $raw && -r $raw ]] || emit_error "Cannot read $typed"
  kind=$(key_file_kind "$raw")
  uid=$(key_file_uid "$raw" || true)
  emit --arg path "$(home_rel "$raw")" --arg kind "$kind" --arg uid "$uid" \
    '{path: $path, exists: true, kind: $kind, uid: $uid}'
}

# Named exports first (so ~/secret.asc wins), then newest *.asc/*.pgp/*.gpg
# in Downloads, Documents, Desktop, and $HOME.
gpg_inspect_defaults() {
  local f d
  {
    for f in \
      "$HOME/secret.asc" "$HOME/private.asc" "$HOME/seckey.asc" \
      "$HOME/secret-key.asc" "$HOME/private-key.asc" \
      "$HOME/.gnupg/secret.asc" "$HOME/.gnupg/private.asc" \
      "$HOME/public.asc" "$HOME/pubkey.asc" "$HOME/public-key.asc" \
      "$HOME/publickey.asc" "$HOME/key.asc" \
      "$HOME/.gnupg/public.asc" "$HOME/.gnupg/key.asc"
    do
      scan_key_file "$f"
    done
    for d in "$(xdg_home_dir DOWNLOAD)" "$(xdg_home_dir DOCUMENTS)" "$(xdg_home_dir DESKTOP)" "$HOME"; do
      [[ -d $d ]] || continue
      find "$d" -maxdepth 1 -type f \( -name '*.asc' -o -name '*.pgp' -o -name '*.gpg' \) \
        -printf '%T@\t%p\n' 2>/dev/null | sort -nr | awk -F '\t' 'NR<=12 { print $2 }'
    done | while IFS= read -r f; do
      scan_key_file "$f"
    done
  } | jq -cs '
    unique_by(.path)
    | {
        files: .,
        defaults: {
          secret: (map(select(.kind == "secret")) | first // null),
          public: (map(select(.kind == "public")) | first // null)
        }
      }'
}

# --- status -----------------------------------------------------------------

deps_json() {
  local otp=false
  if [[ -f "$store/.extensions/otp.bash" ]] \
     || [[ -f "${PASSWORD_STORE_SYSTEM_EXTENSION_DIR:-/usr/lib/password-store/extensions}/otp.bash" ]]; then
    otp=true
  fi
  jq -cn \
    --argjson pass "$(have pass && echo true || echo false)" \
    --argjson gnupg "$(have gpg && echo true || echo false)" \
    --argjson git "$(have git && echo true || echo false)" \
    --argjson rclone "$(have rclone && echo true || echo false)" \
    --argjson wtype "$(have wtype && echo true || echo false)" \
    --argjson otp "$otp" \
    '{pass: $pass, gnupg: $gnupg, git: $git, rclone: $rclone, wtype: $wtype, "pass-otp": $otp}'
}

git_remote_url() {
  [[ -d $store/.git ]] || return 0
  git -C "$store" remote get-url origin 2>/dev/null
}

git_branch() {
  git -C "$store" symbolic-ref --short HEAD 2>/dev/null || echo master
}

git_has_upstream() {
  git -C "$store" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1
}

sync_status_json() {
  local configured=false detail=""
  case $backend in
    local) configured=true; detail="Local only, nothing is synced" ;;
    git)
      if ! have git; then detail="git is not installed"
      elif [[ ! -d $store/.git ]]; then detail="The store is not a git repository yet"
      elif [[ -z $(git_remote_url) ]]; then detail="No origin remote"
      elif ! git_has_upstream; then detail="Branch $(git_branch) has no upstream yet"
      else configured=true; detail="git → $(git_remote_url)"
      fi ;;
    rclone)
      if ! have rclone; then detail="rclone is not installed"
      elif [[ -z $rclone_remote ]]; then detail="No rclone remote path set"
      else configured=true; detail="rclone $rclone_mode → $rclone_remote"
      fi ;;
    custom)
      if [[ -z $push_cmd ]]; then detail="No push command set"
      else configured=true; detail="custom: $push_cmd"
      fi ;;
  esac
  jq -cn \
    --arg backend "$backend" --argjson configured "$configured" --arg detail "$detail" \
    --arg gitRemote "$git_remote" --arg rcloneRemote "$rclone_remote" --arg rcloneMode "$rclone_mode" \
    --arg pushCmd "$push_cmd" --arg pullCmd "$pull_cmd" \
    --argjson gitPullOnOpen "$(is_true "$(setting_or "" gitPullOnOpen true)" && echo true || echo false)" \
    --argjson rclonePullOnOpen "$(is_true "$(setting_or "" rclonePullOnOpen true)" && echo true || echo false)" \
    '{backend: $backend, configured: $configured, detail: $detail,
      gitRemote: $gitRemote, rcloneRemote: $rcloneRemote, rcloneMode: $rcloneMode,
      syncPushCmd: $pushCmd, syncPullCmd: $pullCmd,
      gitPullOnOpen: $gitPullOnOpen, rclonePullOnOpen: $rclonePullOnOpen}'
}

status_json() {
  local exists=false ids secret_present=null usable=false is_git=false id
  [[ -d $store ]] && exists=true
  ids=$(store_gpg_ids_json)
  if [[ $exists == true && $(jq length <<<"$ids") -gt 0 ]]; then
    secret_present=false
    while IFS= read -r id; do
      [[ -n $id ]] || continue
      if have_secret_key "$id"; then secret_present=true; break; fi
    done < <(store_gpg_ids)
    have pass && usable=true
  fi
  [[ -d $store/.git ]] && is_git=true
  jq -cn \
    --argjson deps "$(deps_json)" \
    --arg pinentry "$(pinentry_state)" \
    --arg store "$store" --argjson storeExists "$exists" \
    --argjson gpgIds "$ids" --argjson secretKeyPresent "$secret_present" \
    --argjson usable "$usable" --argjson entries "$(store_entries)" \
    --argjson isGitRepo "$is_git" --arg gitOrigin "$(git_remote_url)" \
    --argjson sync "$(sync_status_json)" \
    --arg vaultId "$vault_id" --arg vaultName "$vault_name" --argjson vaults "$VAULTS_JSON" \
    '{vault: {id: $vaultId, name: $vaultName}, vaults: ($vaults | map({id, name, storeDir})),
      deps: $deps, store: $store, storeExists: $storeExists, gpgIds: $gpgIds,
      secretKeyPresent: $secretKeyPresent, usable: $usable, entries: $entries,
      isGitRepo: $isGitRepo, gitOrigin: $gitOrigin, sync: $sync, pinentry: $pinentry}'
}

# --- the passphrase prompt ----------------------------------------------------

# gpg-agent asks for passphrases through whatever pinentry-program its
# gpg-agent.conf names (the GNOME one by default on Omarchy). pinentry-omarchy,
# next to this script, draws the prompt with the shell's own tokens; enabling
# it is one line in that file plus a reload of the agent.
# The logical directory, not the resolved one: invoked through
# ~/.config/omarchy/plugins/<id>/ the path written to gpg-agent.conf is the
# same on every seat, even where that entry is a symlink to a checkout.
PINENTRY="$(cd -- "$(dirname -- "$0")" && pwd)/pinentry-omarchy"
readonly PINENTRY
AGENT_CONF="${GNUPGHOME:-$HOME/.gnupg}/gpg-agent.conf"

pinentry_state() { # omarchy | other | default
  local current
  current=$(grep -E '^[[:space:]]*pinentry-program[[:space:]]' "$AGENT_CONF" 2>/dev/null | tail -n1 | awk '{print $2}')
  if [[ -z $current ]]; then echo default
  elif [[ $current == "$PINENTRY" ]]; then echo omarchy
  else echo other
  fi
}

pinentry_set() { # enable | disable
  mkdir -p "$(dirname "$AGENT_CONF")" && chmod 700 "$(dirname "$AGENT_CONF")" 2>/dev/null
  local tmp
  tmp=$(mktemp "$AGENT_CONF.XXXXXX") || return 1
  # Every other line is kept; the pinentry-program line is replaced or dropped.
  grep -vE '^[[:space:]]*pinentry-program[[:space:]]' "$AGENT_CONF" 2>/dev/null > "$tmp"
  [[ $1 == enable ]] && printf 'pinentry-program %s\n' "$PINENTRY" >> "$tmp"
  chmod 600 "$tmp" && mv -f "$tmp" "$AGENT_CONF" || { rm -f "$tmp"; return 1; }
  # The agent reads its conf on reload; a running one keeps the old prompt
  # otherwise.
  have gpgconf && gpgconf --reload gpg-agent >/dev/null 2>&1
  return 0
}

# --- sync backends ------------------------------------------------------------

# One sync at a time per store: a pull on open must not interleave with a
# push after an edit.
with_lock() { # command…
  mkdir -p "$STATE_DIR" 2>/dev/null
  (
    flock -w 120 9 || exit 75
    "$@"
  ) 9>"$STATE_DIR/sync.lock"
}

# rclone never carries the git history: the remote holds the entries, and a
# .git tree copied file-by-file while git writes to it would only corrupt.
rclone_args=(--exclude '.git/**' --exclude '.extensions/**')

do_push() {
  case $backend in
    local) return 0 ;;
    git)
      have git || { echo "git is not installed"; return 1; }
      [[ -d $store/.git ]] || { echo "The store is not a git repository (pass git init)"; return 1; }
      git_has_upstream || { echo "No upstream for branch $(git_branch): run the setup again"; return 1; }
      pass git push --quiet 2>&1 ;;
    rclone)
      have rclone || { echo "rclone is not installed"; return 1; }
      [[ -n $rclone_remote ]] || { echo "No rclone remote path set"; return 1; }
      rclone "$rclone_mode" "$store" "$rclone_remote" "${rclone_args[@]}" 2>&1 ;;
    custom)
      [[ -n $push_cmd ]] || { echo "No push command set"; return 1; }
      ( cd "$store" && STORE=$store bash -lc "$push_cmd" ) 2>&1 ;;
  esac
}

do_pull() {
  case $backend in
    local) return 0 ;;
    git)
      have git || { echo "git is not installed"; return 1; }
      [[ -d $store/.git ]] || { echo "The store is not a git repository (pass git init)"; return 1; }
      git_has_upstream || { echo "No upstream for branch $(git_branch): run the setup again"; return 1; }
      pass git pull --rebase --quiet 2>&1 ;;
    rclone)
      have rclone || { echo "rclone is not installed"; return 1; }
      [[ -n $rclone_remote ]] || { echo "No rclone remote path set"; return 1; }
      # Always a copy: a pull must never delete something only this seat has.
      rclone copy "$rclone_remote" "$store" "${rclone_args[@]}" 2>&1 ;;
    custom)
      [[ -n $pull_cmd ]] || return 0
      ( cd "$store" && STORE=$store bash -lc "$pull_cmd" ) 2>&1 ;;
  esac
}

sync_result() { # direction, status, output
  local direction=$1 status=$2 output=$3 tail
  tail=$(printf '%s' "$output" | tr -s '\r\n' '  ' | sed 's/^ *//; s/ *$//')
  tail=${tail:0:400}
  if [[ $status -eq 0 ]]; then
    # A pull that worked ends the "could not pull" state; without this the
    # same error is reported once and then never again.
    [[ $direction == pull ]] && rm -f "$STATE_DIR/last-pull-error"
    jq -cn --arg backend "$backend" --arg direction "$direction" --arg detail "$tail" \
      '{ok: true, backend: $backend, direction: $direction, detail: $detail}'
    return 0
  fi
  local message="${tail:-$direction failed (exit $status)}"
  echo "passwordstore-setup: $backend $direction failed: $message" >&2
  if [[ $direction == push ]]; then
    notify critical "Password Store sync failed" "$message"
  else
    # An unreachable remote would otherwise notify on every open: say it once
    # per distinct error, then stay quiet until the message changes.
    mkdir -p "$STATE_DIR" 2>/dev/null
    local last=""
    [[ -r $STATE_DIR/last-pull-error ]] && last=$(<"$STATE_DIR/last-pull-error")
    if [[ $last != "$message" ]]; then
      printf '%s' "$message" > "$STATE_DIR/last-pull-error" 2>/dev/null
      notify normal "Password Store could not pull" "$message"
    fi
  fi
  jq -cn --arg backend "$backend" --arg direction "$direction" --arg error "$message" \
    '{ok: false, backend: $backend, direction: $direction, error: $error}'
  return 0
}

# First-time wiring. Everything that can want a credential runs in a terminal.
sync_setup() {
  local entries out status
  entries=$(store_entries)
  case $backend in
    local)
      emit --arg store "$store" '{ok: true, backend: "local", detail: ("Local only at " + $store)}' ;;
    git)
      have git || emit_error "git is not installed"
      [[ -d $store ]] || emit_error "No store at $store: initialise it first"
      [[ -n $git_remote ]] || emit_error "A git remote URL is needed"
      case $git_remote in -*) emit_error "Not a remote URL: $git_remote" ;; esac
      if [[ ! -d $store/.git ]]; then
        out=$(pass git init 2>&1) || emit_error "pass git init failed: $out"
      fi
      # Without a git identity the initial commit pass git init makes fails
      # silently, and the first push has nothing to push: give the store a
      # local one rather than fail on a seat that never configured git.
      if [[ -z $(git -C "$store" config user.email 2>/dev/null) ]]; then
        git -C "$store" config user.name "${USER:-pass}"
        git -C "$store" config user.email "${USER:-pass}@$(hostname)"
      fi
      if ! git -C "$store" rev-parse --verify HEAD >/dev/null 2>&1; then
        git -C "$store" add -A >/dev/null 2>&1
        out=$(git -C "$store" commit -q -m "Add current contents of password store." 2>&1) || emit_error "The first commit failed: $out"
      fi
      if git -C "$store" remote get-url origin >/dev/null 2>&1; then
        git -C "$store" remote set-url origin "$git_remote" 2>/dev/null
      else
        out=$(git -C "$store" remote add origin "$git_remote" 2>&1) || emit_error "git remote add failed: $out"
      fi
      local branch script remote_branch=""
      branch=$(git_branch)
      # A fresh store and a remote that already has commits: this seat is
      # joining an existing vault, so take the remote's branch instead of
      # pushing an empty one over it. `checkout -f` drops the .gpg-id that
      # pass init just wrote; the remote's copy is the one that matters.
      if [[ $entries -eq 0 ]]; then
        remote_branch=$(git ls-remote --symref "$git_remote" HEAD 2>/dev/null \
          | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$|\1|p' | head -n 1)
        [[ -n $remote_branch ]] || remote_branch=$(git ls-remote --heads "$git_remote" 2>/dev/null \
          | sed -n 's|.*refs/heads/||p' | head -n 1)
      fi
      if [[ -n $remote_branch ]]; then
        script=$(printf 'set -e; cd %q; echo "Fetching %s…"; git fetch origin; git checkout -f -B %q %q; git branch --set-upstream-to=%q >/dev/null; echo "Vault fetched."' \
          "$store" "$git_remote" "$remote_branch" "origin/$remote_branch" "origin/$remote_branch")
        run_in_terminal "Password Store: fetch" "$script"
        status=$?
        [[ $status -eq 0 ]] || emit_error "Fetching $git_remote failed (exit $status)"
        emit --arg r "$git_remote" --arg b "$remote_branch" \
          '{ok: true, backend: "git", detail: ("Fetched " + $b + " from " + $r), fetched: true}'
      else
        script=$(printf 'set -e; cd %q; echo "Pushing %s to %s…"; git push -u origin %q; echo "Pushed."' \
          "$store" "$branch" "$git_remote" "$branch")
        run_in_terminal "Password Store: push" "$script"
        status=$?
        [[ $status -eq 0 ]] || emit_error "The first push to $git_remote failed (exit $status)"
        emit --arg r "$git_remote" --arg b "$branch" \
          '{ok: true, backend: "git", detail: ("Pushed " + $b + " to " + $r)}'
      fi ;;
    rclone)
      have rclone || emit_error "rclone is not installed"
      [[ -d $store ]] || emit_error "No store at $store: initialise it first"
      [[ -n $rclone_remote ]] || emit_error "An rclone remote path (remote:path) is needed"
      case $rclone_remote in
        -*|/*|*:) emit_error "Not an rclone remote path: $rclone_remote" ;;
        *:*) ;;
        *) emit_error "An rclone remote path looks like remote:path" ;;
      esac
      local script
      if [[ $entries -eq 0 ]]; then
        script=$(printf 'echo "Copying %s into the store…"; rclone copy %q %q %s -v; echo "Done."' \
          "$rclone_remote" "$rclone_remote" "$store" "$(printf '%q ' "${rclone_args[@]}")")
        run_in_terminal "Password Store: rclone" "$script"
        status=$?
        [[ $status -eq 0 ]] || emit_error "rclone copy from $rclone_remote failed (exit $status)"
        emit --arg r "$rclone_remote" '{ok: true, backend: "rclone", detail: ("Copied from " + $r), fetched: true}'
      else
        if ! $confirm; then
          emit --argjson n "$entries" --arg r "$rclone_remote" \
            '{ok: false, needsConfirm: true, entries: $n, detail: ("Upload " + ($n | tostring) + " entries to " + $r + "?")}'
          exit 0
        fi
        script=$(printf 'echo "Copying the store to %s…"; rclone copy %q %q %s -v; echo "Done."' \
          "$rclone_remote" "$store" "$rclone_remote" "$(printf '%q ' "${rclone_args[@]}")")
        run_in_terminal "Password Store: rclone" "$script"
        status=$?
        [[ $status -eq 0 ]] || emit_error "rclone copy to $rclone_remote failed (exit $status)"
        emit --arg r "$rclone_remote" '{ok: true, backend: "rclone", detail: ("Copied to " + $r)}'
      fi ;;
    custom)
      [[ -n $push_cmd ]] || emit_error "A push command is needed (it runs in the store with \$STORE set)"
      emit --arg c "$push_cmd" '{ok: true, backend: "custom", detail: ("Push: " + $c)}' ;;
  esac
}

# --- commands -----------------------------------------------------------------

have jq || { echo "passwordstore-setup: jq is required" >&2; exit 2; }

case $command in
  status)
    status_json ;;

  pinentry)
    # `pinentry` reports; `--enable` points gpg-agent at pinentry-omarchy,
    # `--disable` restores the default prompt.
    if $pinentry_enable; then
      [[ -x $PINENTRY ]] || emit_error "pinentry-omarchy is missing next to passwordstore-setup"
      have qs || emit_error "Quickshell (qs) is not installed; the prompt needs it"
      pinentry_set enable || emit_error "Could not write $AGENT_CONF"
    elif $pinentry_disable; then
      pinentry_set disable || emit_error "Could not write $AGENT_CONF"
    fi
    emit --arg state "$(pinentry_state)" --arg program "$PINENTRY" --arg conf "$AGENT_CONF" \
      '{ok: true, pinentry: $state, program: $program, conf: $conf}' ;;

  gpg-list)
    have gpg || emit_error "gpg is not installed (omarchy pkg add gnupg)"
    jq -cn --argjson keys "$(gpg_list_json)" '{keys: $keys}' ;;

  gpg-generate)
    have gpg || emit_error "gpg is not installed (omarchy pkg add gnupg)"
    # The user stays at the tty: gpg asks for the name, e-mail and, through
    # pinentry, the passphrase. Nothing is answered for them.
    run_in_terminal "Password Store: new GPG key" 'gpg --full-generate-key'
    status=$?
    [[ $status -eq 0 || $status -eq 124 ]] || echo "passwordstore-setup: gpg --full-generate-key exited $status" >&2
    jq -cn --argjson keys "$(gpg_list_json)" --argjson status "$status" '{keys: $keys, status: $status}' ;;

  gpg-import)
    have gpg || emit_error "gpg is not installed (omarchy pkg add gnupg)"
    [[ -n $key_file ]] || emit_error "Which file? (--file PATH)"
    key_file=${key_file/#\~/$HOME}
    [[ -r $key_file ]] || emit_error "Cannot read $key_file"
    # The key material goes from the file to gpg; a passphrase, if the key
    # has one, is asked for by pinentry.
    out=$(gpg --batch --import -- "$key_file" 2>&1)
    status=$?
    [[ $status -eq 0 ]] || emit_error "gpg --import failed: $(tr '\n' ' ' <<<"$out")"
    imported=$(grep -c 'secret key imported\|secret keys imported\|secret keys unchanged\|secret key unchanged' <<<"$out")
    kind=$(key_file_kind "$key_file")
    if [[ $kind != secret && $kind != public ]]; then
      if (( imported > 0 )); then kind=secret; else kind=public; fi
    fi
    jq -cn --argjson keys "$(gpg_list_json)" --argjson secret "$(( imported > 0 ))" \
      --arg kind "$kind" \
      --arg detail "$(grep -E 'secret key|public key|unchanged' <<<"$out" | head -n 2 | tr '\n' ' ')" \
      '{keys: $keys, importedSecret: ($secret == 1), kind: $kind, detail: $detail}' ;;

  gpg-inspect)
    if [[ -n $key_file ]]; then gpg_inspect_file "$key_file"
    else gpg_inspect_defaults
    fi ;;

  install)
    [[ ${#positional[@]} -gt 0 ]] || emit_error "Which packages?"
    for pkg in "${positional[@]}"; do
      [[ $pkg =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || emit_error "Not a package name: $pkg"
    done
    if have omarchy; then installer="omarchy pkg add"
    elif have omarchy-pkg-add; then installer="omarchy-pkg-add"
    else emit_error "omarchy pkg add is not available"
    fi
    run_in_terminal "Password Store: install" "$installer $(printf '%q ' "${positional[@]}")"
    status=$?
    jq -cn --argjson s "$(status_json)" --argjson status "$status" '$s + {installStatus: $status}' ;;

  init)
    have pass || emit_error "pass is not installed (omarchy pkg add pass)"
    [[ ${#gpg_ids[@]} -gt 0 ]] || emit_error "Which key? (--gpg-id ID, repeatable)"
    secret_found=false
    for id in "${gpg_ids[@]}"; do
      [[ -n $id ]] || emit_error "An empty key id"
      case $id in -*) emit_error "Not a key id: $id" ;; esac
      # Every recipient must at least be a known public key, and one of
      # them must be ours, or nothing written here could ever be read here.
      gpg --batch --list-keys -- "$id" >/dev/null 2>&1 || emit_error "No key for $id in this keyring"
      have_secret_key "$id" && secret_found=true
    done
    $secret_found || emit_error "None of those keys has its secret part here; entries could not be decrypted on this machine"
    current=$(store_gpg_ids | LC_ALL=C sort | tr '\n' ' ')
    wanted=$(printf '%s\n' "${gpg_ids[@]}" | LC_ALL=C sort | tr '\n' ' ')
    if [[ -n $current ]]; then
      if [[ $current == "$wanted" ]]; then
        jq -cn --argjson s "$(status_json)" '$s + {ok: true, skipped: true, detail: "The store already uses these keys"}'
        exit 0
      fi
      if ! $reencrypt; then
        jq -cn --argjson s "$(status_json)" --arg cur "$current" --arg new "$wanted" \
          '$s + {ok: false, needsReencrypt: true,
                 detail: ("The store is encrypted for " + $cur + "; re-encrypting it for " + $new + "rewrites every entry")}'
        exit 0
      fi
    fi
    # pass init creates the directory, writes .gpg-id and (for an existing
    # store) re-encrypts every entry; gpg-agent prompts as needed.
    # A key imported for a shared vault has no validity yet, so gpg would
    # ask on a tty this helper does not have, or refuse it. pass swallows
    # the per-entry failure (gpg -d | gpg -e ... || rm) and still rewrites
    # .gpg-id, so every recipient is checked first and gpg's complaints
    # are read afterwards.
    for id in "${gpg_ids[@]}"; do
      gpg --batch --trust-model always -r "$id" -e -o /dev/null </dev/null 2>/dev/null \
        || emit_error "gpg cannot encrypt to $id (expired, revoked, or no encryption subkey); the store was left alone"
    done
    out=$(PASSWORD_STORE_GPG_OPTS="${PASSWORD_STORE_GPG_OPTS:-} --trust-model always" pass init "${gpg_ids[@]}" 2>&1)
    status=$?
    [[ $status -eq 0 ]] || emit_error "pass init failed: $(tr '\n' ' ' <<<"$out")"
    if grep -qiE '^gpg: .*(unusable|no such|not found|skipped|failed|error)' <<<"$out"; then
      emit_error "pass init ran, but gpg complained: $(grep -iE '^gpg:' <<<"$out" | head -n 2 | tr '\n' ' ')"
    fi
    jq -cn --argjson s "$(status_json)" --arg detail "$(head -n 1 <<<"$out")" '$s + {ok: true, detail: $detail}' ;;

  sync-status)
    sync_status_json ;;

  sync-setup)
    sync_setup ;;

  sync-pull)
    [[ $backend != local ]] || { emit '{ok: true, backend: "local", direction: "pull", skipped: true}'; exit 0; }
    [[ -d $store ]] || emit_error "No store at $store"
    out=$(with_lock do_pull)
    sync_result pull $? "$out" ;;

  sync-push)
    [[ $backend != local ]] || { emit '{ok: true, backend: "local", direction: "push", skipped: true}'; exit 0; }
    [[ -d $store ]] || emit_error "No store at $store"
    out=$(with_lock do_push)
    sync_result push $? "$out" ;;

  -h|--help|help)
    usage ;;

  *)
    echo "passwordstore-setup: unknown command: $command" >&2
    exit 2 ;;
esac
