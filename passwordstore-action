#!/bin/bash

# Perform one action on a password-store entry for the Omarchy widget.
#
#   passwordstore-action <action> <entry> [--store DIR] [--recent FILE]
#                        [--clip-time SEC] [--username-keys k1,k2,…] [--quiet]
#                        [--sync] [--vault ID] [--from OLD]
#                        [--length N] [--classes lower,upper,digit,symbol]
#
# Actions:
#   copy-password   copy the first line to the clipboard, cleared after SEC
#   copy-username   copy the username field (or the second line)
#   copy-otp        copy a fresh OTP code (needs pass-otp)
#   type-password   type the first line into the focused window with wtype
#   type-username   type the username field into the focused window
#   read            decrypt the entry and print it as JSON on stdout for the
#                   card's editor: {password, username, created, modified,
#                   notes, extra}
#   save            read {password, username, notes, extra, created} as JSON
#                   from stdin and write the entry with `pass insert -m`;
#                   --from OLD renames OLD to <entry> first; --no-overwrite
#                   refuses an <entry> that already exists
#   generate-password  print a random password (--length, --classes)
#                   (options: [--length N] [--classes lower,upper,digit,symbol])
#   delete          `pass rm -f <entry>`; the card asks first
#   edit            open the entry in a terminal with `pass edit`
#
# Decryption always goes through pass itself, so gpg-agent prompting and the
# store location behave exactly as they do from a terminal. Secrets travel
# over pipes and stdin, never argv.
#
# The clipboard: everything this script copies goes onto the Wayland
# clipboard with wl-copy --sensitive, which offers the
# x-kde-passwordManagerHint type that Omarchy's clipboard history (and any
# other well-behaved manager) refuses to record. After --clip-time seconds the
# clipboard is cleared if it still holds the value; a copy in the meantime
# restarts that timer, as pass's does. Should an older wl-copy have let the
# value into ~/.local/state/omarchy/clipboard-history.json, it is scrubbed
# from there a second after the copy and again at the clear. pass's own `-c`
# is not used because it copies without the hint.
#
# Entry format written by `save` (and understood by `read`):
#
#   <password>
#   username: <username>
#   created: <ISO 8601>
#   modified: <ISO 8601>
#   <other key: value lines an older entry had, kept as they were>
#
#   <notes, free text>
#
# The entry's path is <name>/<username> when there is a username, so the card
# can show both without decrypting anything.
#
# Outcome is reported with notify-send (unless --quiet) and the exit code; the
# widget has already closed its popup by the time this runs.
#
# With --sync, the actions that change the store (save, delete, edit) finish with `passwordstore-setup sync-push`, which pushes to the
# configured backend and notifies if that fails; the change itself is never
# held back by the push.

set -uo pipefail

action=${1:-}
entry=${2:-}
shift 2 2>/dev/null || { echo "usage: passwordstore-action <action> <entry> [options]" >&2; exit 2; }

SETUP="$(dirname -- "$(readlink -f -- "$0")")/passwordstore-setup"
readonly SETUP
PINENTRY="$(dirname -- "$(readlink -f -- "$0")")/pinentry-omarchy"
readonly PINENTRY

store=""
recent_file=""
clip_time=60
username_keys="login,user,username,email"
quiet=false
sync=false
vault=""
from=""
no_overwrite=false
gen_length=20
gen_classes="lower,upper,digit,symbol"

while [[ $# -gt 0 ]]; do
  case $1 in
    --store) store=${2:-}; shift 2 ;;
    --recent) recent_file=${2:-}; shift 2 ;;
    --clip-time) clip_time=${2:-60}; shift 2 ;;
    --username-keys) username_keys=${2:-}; shift 2 ;;
    --quiet) quiet=true; shift ;;
    --sync) sync=true; shift ;;
    --vault) vault=${2:-}; shift 2 ;;
    --from) from=${2:-}; shift 2 ;;
    --no-overwrite) no_overwrite=true; shift ;;
    --length) gen_length=${2:-20}; shift 2 ;;
    --classes) gen_classes=${2:-}; shift 2 ;;
    *) echo "passwordstore-action: unknown argument: $1" >&2; exit 2 ;;
  esac
done

[[ -n $action ]] || { echo "usage: passwordstore-action <action> <entry> [options]" >&2; exit 2; }
case $action in
  generate-password) ;;
  *) [[ -n $entry ]] || { echo "usage: passwordstore-action <action> <entry> [options]" >&2; exit 2; } ;;
esac

# A name with a leading dash or a traversal component is not a pass entry.
valid_name() { # name
  case $1 in
    -*|*..*|/*|*/) return 1 ;;
  esac
  return 0
}
valid_name "$entry" || { echo "passwordstore-action: refusing entry name: $entry" >&2; exit 2; }
if [[ -n $from ]] && ! valid_name "$from"; then
  echo "passwordstore-action: refusing entry name: $from" >&2; exit 2
fi

if [[ -n $store ]]; then
  store=${store/#\~/$HOME}
  export PASSWORD_STORE_DIR=${store%/}
fi
[[ $clip_time =~ ^[0-9]+$ ]] || clip_time=60
export PASSWORD_STORE_CLIP_TIME=$clip_time

notify() { # urgency, summary, body
  # --quiet silences the "copied" confirmations only; a failure is always
  # worth a notification, since the popup is gone by the time it happens.
  [[ $1 == low ]] && $quiet && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  # No --icon: there is no password glyph common to the icon themes Omarchy
  # ships, and a missing one renders as a checkerboard in the shell.
  # The body may contain an entry name or a username; notification daemons
  # treat bodies as markup, so escape it rather than let a crafted name render.
  # (`\&`: with bash's patsub_replacement, a bare & in the replacement means
  # "the matched text".)
  local body=${3//&/\&amp;}
  body=${body//</\&lt;}
  body=${body//>/\&gt;}
  notify-send --app-name "Password Store" --urgency "$1" --expire-time 4000 \
    "$2" "$body" 2>/dev/null || true
}

fail() { # message
  echo "passwordstore-action: $1" >&2
  notify critical "Password Store" "$1"
  exit 1
}

remember() {
  [[ -n $recent_file ]] || return 0
  mkdir -p "$(dirname "$recent_file")" 2>/dev/null || return 0
  printf '%s\n' "$entry" >> "$recent_file" 2>/dev/null || return 0
  # Keep the file from growing without bound: the list only ever reads the
  # last twenty distinct names.
  if [[ $(wc -l < "$recent_file") -gt 200 ]]; then
    tail -n 100 "$recent_file" > "$recent_file.tmp" && mv "$recent_file.tmp" "$recent_file"
  fi
}

# The username: the value of the first line whose key (before ':') matches one
# of --username-keys, case-insensitively; failing that, the bare second line,
# which is where pass's own conventions put it. Takes the decrypted content so
# an entry is decrypted once per action.
username_value() {
  local content=$1
  local n=0 line key k value
  IFS=',' read -ra keys <<<"${username_keys,,}"
  while IFS= read -r line; do
    n=$(( n + 1 ))
    [[ $n -gt 1 ]] || continue
    key=${line%%:*}
    [[ $key != "$line" ]] || continue
    key=${key,,}
    key=${key// /}
    for k in "${keys[@]}"; do
      k=${k// /}
      if [[ -n $k && $k == "$key" ]]; then
        value=${line#*:}
        value=${value# }
        printf '%s' "$value"
        return 0
      fi
    done
  done <<<"$content"
  # Second line, if it exists and is not some other key: value pair (a "url:"
  # line would be a surprising thing to paste as a username).
  local second
  second=$(sed -n '2p' <<<"$content")
  if [[ -n $second && $second != *:* ]]; then printf '%s' "$second"; return 0; fi
  return 1
}

# --- clipboard --------------------------------------------------------------

# The shell's clipboard plugin writes under $HOME regardless of
# XDG_STATE_HOME; PASSWORDSTORE_CLIPBOARD_HISTORY is the test hook.
clipboard_history="${PASSWORDSTORE_CLIPBOARD_HISTORY:-$HOME/.local/state/omarchy/clipboard-history.json}"

# Drop every text entry equal to the value on stdin from Omarchy's clipboard
# history file. The shell watches that file and reloads it, so the entry
# disappears from the picker too. Normally there is nothing to do: the
# --sensitive hint keeps the value out in the first place.
purge_history() {
  [[ -s $clipboard_history ]] || { cat >/dev/null; return 0; }
  command -v jq >/dev/null 2>&1 || { cat >/dev/null; return 0; }
  local tmp
  tmp=$(mktemp "$clipboard_history.XXXXXX") || { cat >/dev/null; return 0; }
  if jq --rawfile s /dev/stdin 'if type == "array" then map(select((.type // "text") != "text" or (.text // "") != $s)) else . end' \
       "$clipboard_history" > "$tmp" 2>/dev/null \
     && ! cmp -s "$tmp" "$clipboard_history"; then
    mv -f "$tmp" "$clipboard_history"
  else
    rm -f "$tmp"
  fi
}

# Copy a value onto the clipboard with the password-manager hint, then clear
# it after --clip-time seconds unless something else has been copied since,
# and scrub the history file either way. The value only ever travels over a
# pipe: the sleeper is a subshell that inherits the variable. The sleep runs
# under a recognisable name so the next copy can kill it (as pass does), which
# restarts the timer; a killed sleeper skips the clear but still purges.
readonly SLEEP_ARGV0="passwordstore clip sleep"
clip_value() { # value
  command -v wl-copy >/dev/null 2>&1 || fail "wl-copy is not installed (omarchy pkg add wl-clipboard)"
  local value=$1
  local -a copy=(wl-copy)
  # wl-clipboard 2.3 grew --sensitive; older versions copy without the hint
  # and rely on the purge below.
  wl-copy --help 2>&1 | grep -q -- '--sensitive' && copy+=(--sensitive)
  pkill -f "^$SLEEP_ARGV0" 2>/dev/null && sleep 0.2
  printf '%s' "$value" | "${copy[@]}" || fail "Could not write to the clipboard"
  (
    # Early scrub, for a capture that happened without the hint; the
    # shell needs a moment to write the file after the copy.
    # (`sleep & wait` rather than a bare sleep: bash would exec a lone
    # command and the name pkill looks for would be gone with it.)
    ( exec -a "$SLEEP_ARGV0" bash -c "trap 'kill %1; exit 1' TERM; sleep 1 & wait" ) && printf '%s' "$value" | purge_history
    if ( exec -a "$SLEEP_ARGV0" bash -c "trap 'kill %1; exit 1' TERM; sleep $(( clip_time > 1 ? clip_time - 1 : 0 )) & wait" ); then
      [[ "$(wl-paste -n 2>/dev/null)" == "$value" ]] && wl-copy --clear
    fi
    printf '%s' "$value" | purge_history
  ) >/dev/null 2>&1 &
  disown
}

# --- entry format -----------------------------------------------------------

# Decrypted content -> JSON for the editor. Line 1 is the password; the lines
# up to the first blank one are `key: value` metadata (username under one of
# --username-keys, created, modified; anything else is kept verbatim in
# `extra`, an otpauth:// line included); everything after the blank line is
# the notes.
entry_json() { # content
  local content=$1
  printf '%s' "$content" | jq -Rs --arg keys "${username_keys,,}" '
    ($keys | split(",") | map(gsub(" "; "") | select(length > 0))) as $ukeys
    | (split("\n") | map(sub("\r$"; ""))) as $lines
    | ($lines | if length > 0 then .[0] else "" end) as $password
    | ($lines[1:] | index("")) as $blank
    | ($lines[1:] | if $blank == null then . else .[:$blank] end) as $meta
    | ($lines[1:] | if $blank == null then [] else .[$blank + 1:] end) as $rest
    | reduce $meta[] as $line (
        {username: "", created: "", modified: "", extra: [], second: ""};
        ($line | capture("^(?<k>[^:[:space:]]+):[ ]?(?<v>.*)$")? // null) as $kv
        | if $kv == null then .extra += [$line] | (if .second == "" and (.extra | length) == 1 and $line != "" then .second = $line else . end)
          elif ($kv.k | ascii_downcase) == "created" and .created == "" then .created = $kv.v
          elif ($kv.k | ascii_downcase) == "modified" and .modified == "" then .modified = $kv.v
          elif (($kv.k | ascii_downcase) as $k | $ukeys | index($k)) != null and .username == "" then .username = $kv.v
          else .extra += [$line] end)
    | {password: $password,
       # pass convention: a bare second line is the username
       username: (if .username == "" and .second != "" and (.second | test(":") | not) then .second else .username end),
       created, modified,
       extra: (.extra | map(select(. != ""))),
       notes: ($rest | join("\n") | sub("\n+$"; ""))}
    | del(.second)'
}

# JSON on stdin -> the file content, on stdout.
entry_content() { # now
  jq -r --arg now "$1" '
    [ (.password // ""),
      (if (.username // "") != "" then "username: " + .username else empty end),
      "created: " + (if (.created // "") != "" then .created else $now end),
      "modified: " + $now
    ] + ((.extra // []) | map(select(type == "string" and . != "")))
    + (if (.notes // "") != "" then ["", .notes] else [] end)
    | join("\n")'
}

# --- terminals --------------------------------------------------------------

# A floating terminal for the actions that need one, detached: the popup is
# gone and nothing waits for the user to finish editing. The same launcher
# order as passwordstore-setup, so the two look alike.
launch_terminal() { # title, script
  if [[ -n ${PASSWORDSTORE_TERMINAL:-} ]]; then
    # Test hook: runs `bash -c SCRIPT` itself.
    # shellcheck disable=SC2086  # word-split on purpose
    $PASSWORDSTORE_TERMINAL bash -c "$2" </dev/null >/dev/null 2>&1 &
    disown
  elif command -v uwsm-app >/dev/null 2>&1 && command -v xdg-terminal-exec >/dev/null 2>&1; then
    setsid -f uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="$1" \
      -e bash -c "$2" </dev/null >/dev/null 2>&1
  elif command -v omarchy-launch-terminal >/dev/null 2>&1; then
    setsid -f omarchy-launch-terminal bash -c "$2" </dev/null >/dev/null 2>&1
  else
    fail "No terminal launcher found for: $1"
  fi
}

# The shell snippet a terminal action runs first: the store and clip time,
# exported again in case the launcher does not pass the environment through.
terminal_prelude() {
  printf 'export PASSWORD_STORE_CLIP_TIME=%q; ' "$clip_time"
  [[ -n ${PASSWORD_STORE_DIR:-} ]] && printf 'export PASSWORD_STORE_DIR=%q; ' "$PASSWORD_STORE_DIR"
  return 0
}

sync_push_cmd() {
  local cmd
  cmd=$(printf '%q sync-push' "$SETUP")
  [[ -n $vault ]] && cmd+=$(printf ' --vault %q' "$vault")
  [[ -n ${PASSWORD_STORE_DIR:-} ]] && cmd+=$(printf ' --store %q' "$PASSWORD_STORE_DIR")
  printf '%s' "$cmd"
}

# …and the snippet it ends with: the push, reported in one line, when --sync.
terminal_sync() {
  $sync || return 0
  printf '; if [[ $? -eq 0 ]]; then %s | jq -r %q; sleep 1.5; fi' "$(sync_push_cmd)" \
    'if .ok then "Synced (" + .backend + ")." else "Sync failed: " + (.error // .detail // "see the notification") end'
}

# The push after a non-terminal change: sync-push notifies on failure itself.
sync_now() {
  $sync || return 0
  eval "$(sync_push_cmd)" >/dev/null 2>&1 || true
}

# --- the lockout ------------------------------------------------------------

# pinentry-omarchy counts wrong passphrases; gpg-agent never tells it about
# the third try of a request, so the outcome of every decrypt done here is
# reported to it, and nothing is even attempted while it says locked.
lockout_json() { [[ -x $PINENTRY ]] && "$PINENTRY" --lockout-status 2>/dev/null || echo '{}'; }

refuse_if_locked() {
  local status remaining
  status=$(lockout_json)
  [[ $(jq -r '.locked // false' <<<"$status") == true ]] || return 0
  remaining=$(jq -r '.remaining // 0' <<<"$status")
  fail "Locked after too many wrong passphrases; try again in $(( remaining / 60 )):$(printf '%02d' $(( remaining % 60 )))"
}

# pass show, with the outcome reported. gpg's status lines (--status-fd,
# through pass's PASSWORD_STORE_GPG_OPTS) say what happened in any language:
# BAD_PASSPHRASE counts, a decrypt that worked clears the count, and "no
# secret key", "no data" or a cancelled prompt count for nothing. On
# failure the human-readable stderr, minus the status lines, is the
# content returned.
pass_show() { # entry -> content on stdout
  local content status errfile
  errfile=$(mktemp) || { pass show "$1" 2>&1; return $?; }
  content=$(PASSWORD_STORE_GPG_OPTS="${PASSWORD_STORE_GPG_OPTS:-} --status-fd 2" pass show "$1" 2>"$errfile"); status=$?
  if [[ $status -eq 0 ]]; then
    [[ -x $PINENTRY ]] && "$PINENTRY" --unlock-ok >/dev/null 2>&1
  else
    if grep -q '^\[GNUPG:\] BAD_PASSPHRASE' "$errfile"; then
      [[ -x $PINENTRY ]] && "$PINENTRY" --unlock-failed >/dev/null 2>&1
    fi
    content=$(grep -v '^\[GNUPG:\]' "$errfile" | tr -d '\r')
  fi
  rm -f "$errfile"
  printf '%s' "$content"
  return "$status"
}

type_text() {
  command -v wtype >/dev/null 2>&1 || fail "wtype is not installed (omarchy pkg add wtype)"
  # The popup is closing as this runs; give the compositor a moment to hand
  # keyboard focus back to the window the user was in.
  sleep 0.25
  printf '%s' "$1" | wtype -
}

case $action in
  copy-password)
    refuse_if_locked
    content=$(pass_show "$entry") || fail "${content:-Could not read $entry}"
    name=$(username_value "$content" 2>/dev/null) || name=""
    secret=${content%%$'\n'*}
    unset content
    clip_value "$secret"
    unset secret
    remember
    notify low "Password copied" "${entry}${name:+$'\n'$name}"$'\n'"Clipboard clears in ${clip_time} s"
    ;;

  copy-username)
    refuse_if_locked
    content=$(pass_show "$entry") || fail "${content:-Could not read $entry}"
    name=$(username_value "$content") || fail "No username field in $entry"
    unset content
    clip_value "$name"
    remember
    notify low "Username copied" "$entry"$'\n'"$name"$'\n'"Clipboard clears in ${clip_time} s"
    ;;

  copy-otp)
    refuse_if_locked
    # stdout only, and only a code: gpg prints "encrypted with ..." on
    # stderr from a cold agent, and that banner must not become the
    # clipboard value.
    code=$(pass otp code "$entry" 2>/dev/null | grep -E '^[0-9]{6,8}$' | tail -n1)
    [[ -n $code ]] || fail "No one-time code in $entry"
    clip_value "$code"
    unset code
    remember
    notify low "OTP copied" "$entry"$'\n'"Clipboard clears in ${clip_time} s"
    ;;

  type-password)
    refuse_if_locked
    secret=$(pass_show "$entry") || fail "${secret:-Could not read $entry}"
    secret=${secret%%$'\n'*}
    type_text "$secret"
    unset secret
    remember
    ;;

  type-username)
    refuse_if_locked
    content=$(pass_show "$entry") || fail "${content:-Could not read $entry}"
    name=$(username_value "$content") || fail "No username field in $entry"
    unset content
    type_text "$name"
    remember
    ;;

  read)
    # For the card's editor. The JSON goes to stdout, which is the pipe the
    # card reads; nothing is notified, the card shows its own errors.
    refuse_if_locked
    content=$(pass_show "$entry") || { echo "${content:-Could not read $entry}" >&2; exit 1; }
    entry_json "$content" || { echo "Could not parse $entry" >&2; exit 1; }
    unset content
    ;;

  save)
    # JSON on stdin; the entry file is composed here and handed to pass on
    # its stdin. --from OLD: the entry was renamed in the editor, so move the
    # old file (its git history with it) before overwriting.
    body=$(entry_content "$(date -Iseconds)") || fail "Could not read the entry from stdin"
    [[ -n ${body%%$'\n'*} ]] || fail "The password is empty"
    # A new entry, or a rename, must not land on an entry that exists: pass
    # would overwrite it without a word.
    if $no_overwrite && [[ -e "${PASSWORD_STORE_DIR:-$HOME/.password-store}/$entry.gpg" ]]; then
      fail "$entry already exists"
    fi
    if [[ -n $from && $from != "$entry" ]]; then
      err=$(pass mv -f "$from" "$entry" 2>&1) || fail "Could not rename $from: ${err:-pass mv failed}"
    fi
    err=$(printf '%s\n' "$body" | pass insert -m -f "$entry" 2>&1 >/dev/null) || fail "Could not save $entry: ${err:-pass insert failed}"
    unset body
    remember
    notify low "Saved" "$entry"
    sync_now
    jq -cn --arg e "$entry" '{ok: true, entry: $e}'
    ;;

  delete)
    err=$(pass rm -f "$entry" 2>&1 >/dev/null) || fail "Could not delete $entry: ${err:-pass rm failed}"
    notify low "Deleted" "$entry"
    sync_now
    jq -cn --arg e "$entry" '{ok: true, entry: $e}'
    ;;

  generate-password)
    # Random bytes filtered to the chosen classes, with at least one character
    # of each class present. The result goes to stdout, for the editor's
    # password field.
    [[ $gen_length =~ ^[0-9]+$ ]] && (( gen_length >= 4 && gen_length <= 256 )) \
      || { echo "passwordstore-action: --length must be 4..256" >&2; exit 2; }
    charset=""
    declare -a classes=()
    IFS=',' read -ra want <<<"$gen_classes"
    for c in "${want[@]}"; do
      case $c in
        lower)  charset+="a-z"; classes+=("*[[:lower:]]*") ;;
        upper)  charset+="A-Z"; classes+=("*[[:upper:]]*") ;;
        digit)  charset+="0-9"; classes+=("*[[:digit:]]*") ;;
        # Symbols that survive being typed by wtype and pasted into most
        # sign-up forms: no quotes, backslash, backtick, pipe or space.
        symbol) charset+='!@#$%^&*()_+=[]{}:;,.?~-'; classes+=("*[![:alnum:]]*") ;;
        "") ;;
        *) echo "passwordstore-action: unknown class: $c" >&2; exit 2 ;;
      esac
    done
    [[ -n $charset ]] || { echo "passwordstore-action: no character classes selected" >&2; exit 2; }
    for _ in $(seq 1 50); do
      candidate=$(LC_ALL=C tr -dc "$charset" < /dev/urandom | head -c "$gen_length")
      [[ ${#candidate} -eq $gen_length ]] || continue
      complete=true
      for pattern in "${classes[@]}"; do
        # shellcheck disable=SC2254  # the pattern is meant to glob-match
        case $candidate in $pattern) ;; *) complete=false; break ;; esac
      done
      $complete && { printf '%s\n' "$candidate"; exit 0; }
    done
    fail "Could not generate a password"
    ;;

  edit)
    launch_terminal "Password Store: edit" \
      "$(terminal_prelude)$(printf 'pass edit %q' "$entry")$(terminal_sync)"
    ;;

  *)
    echo "passwordstore-action: unknown action: $action" >&2
    exit 2
    ;;
esac
