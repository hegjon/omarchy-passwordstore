#!/bin/bash

# List the entries of a password store as JSON for the Omarchy widget.
#
#   passwordstore-list [--store DIR] [--recent FILE]
#
# Prints {"entries":[...],"recent":[...],"store":"…","otp":bool,"count":N} on
# stdout. Failures are reported as {"error":"…"} with exit 0 so the panel can
# always render a reason; only a bad invocation exits non-zero.
#
# Entries are the *.gpg files below the store, as pass names them: relative to
# the store, without the extension, sorted. Nothing here decrypts anything.

set -uo pipefail

store=""
recent_file=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --store) store=${2:-}; shift 2 ;;
    --recent) recent_file=${2:-}; shift 2 ;;
    -h|--help)
      sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "passwordstore-list: unknown argument: $1" >&2; exit 2 ;;
  esac
done

# Same resolution order as pass itself.
[[ -n $store ]] || store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
store=${store/#\~/$HOME}
store=${store%/}

if ! command -v pass >/dev/null 2>&1; then
  jq -cn '{error: "pass is not installed. Install it with: omarchy pkg add pass"}'
  exit 0
fi

if [[ ! -d $store ]]; then
  jq -cn --arg s "$store" \
    '{error: ("No password store at " + $s + ". Create one with: pass init <gpg-id>"), store: $s}'
  exit 0
fi

# pass otp lives in the store's .extensions/ or the system extension dir; the
# widget only offers the OTP action when one of them is present.
otp=false
if [[ -f "$store/.extensions/otp.bash" ]] \
   || [[ -f "${PASSWORD_STORE_SYSTEM_EXTENSION_DIR:-/usr/lib/password-store/extensions}/otp.bash" ]]; then
  otp=true
fi

# Entries: every *.gpg below the store, skipping VCS and extension folders.
# Sorted with LC_ALL=C so the order is stable across locales.
entries=$(cd "$store" && find . \
    \( -name .git -o -name .extensions -o -name .gpg-id \) -prune -o \
    -type f -name '*.gpg' -print 2>/dev/null \
  | sed -e 's|^\./||' -e 's|\.gpg$||' | LC_ALL=C sort)

# Recently used names, most recent first, restricted to entries that still
# exist so a renamed password does not linger at the top.
recent=""
if [[ -n $recent_file && -r $recent_file ]]; then
  recent=$(tac "$recent_file" 2>/dev/null | awk '!seen[$0]++' | head -n 20)
fi

jq -cn \
  --arg store "$store" \
  --argjson otp "$otp" \
  --rawfile entries <(printf '%s' "$entries") \
  --rawfile recent <(printf '%s' "$recent") '
  ($entries | split("\n") | map(select(length > 0))) as $list
  | ($recent | split("\n") | map(select(length > 0))) as $seen
  | {
      store: $store,
      otp: $otp,
      count: ($list | length),
      entries: $list,
      recent: ($seen | map(select(. as $n | $list | index($n) != null)))
    }'
