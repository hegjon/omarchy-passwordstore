#!/bin/bash

# Exercise passwordstore-action against stand-ins for pass, wl-copy, wtype and
# notify-send, so the tests never touch a real store, gpg-agent or clipboard.
# Each stand-in records what it was asked to do under $work.

set -uo pipefail

TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly TEST_DIR
PLUGIN_DIR="$(dirname -- "$TEST_DIR")"
readonly PLUGIN_DIR
readonly ACTION="$PLUGIN_DIR/passwordstore-action"

work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin" "$work/state/omarchy"
export WORK="$work"
export PASSWORDSTORE_CLIPBOARD_HISTORY="$work/state/omarchy/clipboard-history.json"

# pass: `show NAME` prints a fixture, `otp code NAME` prints a code. Anything
# for "missing" fails like pass does.
cat > "$work/bin/pass" <<'SHIM'
#!/bin/bash
printf '%s\n' "$*" >> "$WORK/pass.calls"
printf '%s\n' "${PASSWORD_STORE_DIR:-}" > "$WORK/pass.store"
case "$*" in
  *missing*) echo "Error: missing is not in the password store." >&2; exit 1 ;;
esac
case $1 in
  show) printf 'hunter2\nlogin: alice@example.com\nurl: https://example.com\n' ;;
  otp) [[ $2 == code ]] && echo 123456; exit 0 ;;
  *) exit 1 ;;
esac
SHIM

cat > "$work/bin/wl-copy" <<'SHIM'
#!/bin/bash
printf '%s\n' "$*" >> "$WORK/wlcopy.calls"
case ${1:-} in
  --help) echo "    --sensitive		Hint that the content is sensitive."; exit 0 ;;
  --clear) touch "$WORK/cleared"; : > "$WORK/clipboard"; exit 0 ;;
esac
cat > "$WORK/clipboard"
SHIM
cat > "$work/bin/wl-paste" <<'SHIM'
#!/bin/bash
cat "$WORK/clipboard" 2>/dev/null
SHIM
cat > "$work/bin/wtype" <<'SHIM'
#!/bin/bash
cat > "$WORK/typed"
SHIM
cat > "$work/bin/notify-send" <<'SHIM'
#!/bin/bash
printf '%s\n' "$*" >> "$WORK/notify.calls"
SHIM
chmod +x "$work/bin/"*
export PATH="$work/bin:$PATH"

passed=0
failed=0
ok()  { printf '  ok    %s\n' "$1"; passed=$(( passed + 1 )); }
bad() { printf '  FAIL  %s\n' "$1"; failed=$(( failed + 1 )); }
reset() {
  rm -f "$work"/{pass.calls,clipboard,cleared,typed,notify.calls,recent,wlcopy.calls}
  # Omarchy's clipboard history, as if an older wl-copy had let the password in.
  printf '[{"type":"text","text":"keep me"},{"type":"text","text":"hunter2"},{"type":"image","path":"/tmp/x.png"}]\n' \
    > "$work/state/omarchy/clipboard-history.json"
}

echo "passwordstore-action"

reset
start=$(date +%s%N)
"$ACTION" copy-password web/site --recent "$work/recent" --clip-time 1 >/dev/null 2>&1
[[ $? -eq 0 ]] && ok "copy-password exits 0" || bad "copy-password exits 0"
# Milliseconds, not $SECONDS: a whole-second counter can tick between
# the two readings and report a second that never passed.
[[ $(( ( $(date +%s%N) - start ) / 1000000 )) -lt 900 ]] && ok "copy-password returns without waiting for the clipboard sleeper" \
  || bad "copy-password returns without waiting for the clipboard sleeper"
[[ $(cat "$work/clipboard" 2>/dev/null) == "hunter2" ]] && ok "copy-password copies the first line alone" \
  || bad "copy-password copies the first line alone"
grep -qx -- '--sensitive' "$work/wlcopy.calls" && ok "copy-password copies with wl-copy --sensitive (kept out of the clipboard history)" \
  || bad "copy-password copies with wl-copy --sensitive (kept out of the clipboard history)"
grep -q 'show -c' "$work/pass.calls" && bad "copy-password no longer uses pass -c" || ok "copy-password no longer uses pass -c"
grep -q 'clears in 1 s' "$work/notify.calls" && ok "copy-password notifies with the clip time" \
  || bad "copy-password notifies with the clip time"
grep -qzP 'web/site\nalice@example.com\nClipboard clears in 1 s' "$work/notify.calls" \
  && ok "copy-password lists entry, username and clip time on separate lines" \
  || bad "copy-password lists entry, username and clip time on separate lines"
[[ $(cat "$work/recent") == "web/site" ]] && ok "copy-password records the entry as recent" \
  || bad "copy-password records the entry as recent"
sleep 1.6
[[ -e $work/cleared ]] && ok "copy-password clears the clipboard after the clip time" \
  || bad "copy-password clears the clipboard after the clip time"
history=$(cat "$work/state/omarchy/clipboard-history.json")
[[ $history != *hunter2* && $history == *"keep me"* && $history == *x.png* ]] \
  && ok "copy-password removes the password from the clipboard history, nothing else" \
  || bad "copy-password removes the password from the clipboard history, nothing else"

reset
"$ACTION" copy-password web/site --clip-time 30 --quiet >/dev/null 2>&1
sleep 1.4
history=$(cat "$work/state/omarchy/clipboard-history.json")
[[ $history != *hunter2* ]] && ok "the history is scrubbed a second after the copy, not only at the clear" \
  || bad "the history is scrubbed a second after the copy, not only at the clear"
pkill -f '^passwordstore clip sleep' >/dev/null 2>&1; sleep 0.3

reset
"$ACTION" copy-password web/site --clip-time 2 --quiet >/dev/null 2>&1
sleep 1.2
"$ACTION" copy-password web/site --clip-time 2 --quiet >/dev/null 2>&1
sleep 1.3
[[ ! -e $work/cleared ]] && ok "a second copy restarts the clear timer" || bad "a second copy restarts the clear timer"
sleep 1.5
[[ -e $work/cleared ]] && ok "…and the clipboard is cleared when the new timer runs out" \
  || bad "…and the clipboard is cleared when the new timer runs out"

reset
printf 'something else' > "$work/clipboard"
"$ACTION" copy-password web/site --clip-time 1 --quiet >/dev/null 2>&1
printf 'something else' > "$work/clipboard"
sleep 1.6
[[ ! -e $work/cleared ]] && ok "the clipboard is left alone when something else was copied since" \
  || bad "the clipboard is left alone when something else was copied since"

reset
"$ACTION" copy-username web/site --clip-time 1 >/dev/null 2>&1
[[ $(cat "$work/clipboard" 2>/dev/null) == "alice@example.com" ]] \
  && ok "copy-username copies the login: value alone" \
  || bad "copy-username copies the login: value alone"
sleep 1.5
[[ -e $work/cleared ]] && ok "copy-username clears the clipboard after the clip time" \
  || bad "copy-username clears the clipboard after the clip time"

reset
"$ACTION" copy-username web/site --username-keys email --clip-time 1 >/dev/null 2>&1
[[ $? -ne 0 && ! -e $work/clipboard ]] \
  && ok "copy-username fails when no username key matches and line 2 is key: value" \
  || bad "copy-username fails when no username key matches and line 2 is key: value"
grep -q 'No username field' "$work/notify.calls" && ok "… and says so in a notification" \
  || bad "… and says so in a notification"

reset
"$ACTION" type-password web/site --quiet >/dev/null 2>&1
[[ $(cat "$work/typed" 2>/dev/null) == "hunter2" ]] && ok "type-password types the first line, no newline" \
  || bad "type-password types the first line, no newline"
[[ ! -e $work/notify.calls ]] && ok "--quiet suppresses the success notification" \
  || bad "--quiet suppresses the success notification"

reset
"$ACTION" type-username web/site >/dev/null 2>&1
[[ $(cat "$work/typed" 2>/dev/null) == "alice@example.com" ]] && ok "type-username types the username" \
  || bad "type-username types the username"

reset
"$ACTION" copy-otp web/site --clip-time 1 >/dev/null 2>&1
grep -qx 'otp code web/site' "$work/pass.calls" && ok "copy-otp asks pass otp for a code" \
  || bad "copy-otp asks pass otp for a code"
[[ $(cat "$work/clipboard" 2>/dev/null) == "123456" ]] && grep -qx -- '--sensitive' "$work/wlcopy.calls" \
  && ok "copy-otp copies the code with the sensitive hint" || bad "copy-otp copies the code with the sensitive hint"

reset
"$ACTION" copy-password missing --quiet >/dev/null 2>&1
[[ $? -eq 1 ]] && ok "a pass failure exits 1" || bad "a pass failure exits 1"
grep -q 'not in the password store' "$work/notify.calls" && ok "a pass failure is notified even with --quiet" \
  || bad "a pass failure is notified even with --quiet"

reset
"$ACTION" copy-password 'x/<b>bold</b> & co' --clip-time 1 >/dev/null 2>&1
grep -q 'x/&lt;b&gt;bold&lt;/b&gt; &amp; co' "$work/notify.calls" && ok "markup in an entry name is escaped in the notification" \
  || bad "markup in an entry name is escaped in the notification"

reset
"$ACTION" copy-password ../etc/passwd >/dev/null 2>&1
[[ $? -eq 2 && ! -e $work/pass.calls ]] && ok "traversal in the entry name is refused before pass runs" \
  || bad "traversal in the entry name is refused before pass runs"

reset
# shellcheck disable=SC2088  # the literal tilde is the point: the script expands it
HOME=/home/t "$ACTION" copy-password x --store "~/custom/" --quiet >/dev/null 2>&1
[[ $(cat "$work/pass.store") == "/home/t/custom" ]] && ok "--store expands ~ and strips the trailing slash into PASSWORD_STORE_DIR" \
  || bad "--store expands ~ and strips the trailing slash into PASSWORD_STORE_DIR"

reset
"$ACTION" copy-password x --quiet >/dev/null 2>&1
[[ -z $(cat "$work/pass.store") ]] && ok "without --store pass resolves the store itself" \
  || bad "without --store pass resolves the store itself"

echo
printf '%d passed, %d failed\n' "$passed" "$failed"
(( failed == 0 ))
