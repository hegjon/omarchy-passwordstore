#!/usr/bin/env python3
"""A pinentry for gpg-agent that asks in Omarchy's own style.

gpg-agent talks the Assuan pinentry protocol on stdin/stdout; this program
answers it and, when a passphrase or a confirmation is needed, shows a card
drawn by Quickshell with the shell's tokens (pinentry/shell.qml), the way the
polkit and lock prompts look. The passphrase travels from that card over a
unix socket in $XDG_RUNTIME_DIR back here, and from here to gpg-agent on
stdout: never argv, never a file.

Point gpg-agent at it with `pinentry-program /path/to/pinentry-omarchy` in
~/.gnupg/gpg-agent.conf, then `gpgconf --reload gpg-agent`
(`passwordstore-setup pinentry --enable` does both).

Test hook: PINENTRY_OMARCHY_PROMPT names a command run in place of
Quickshell; it receives the same environment and must write the result JSON
to the socket.

Lockout: gpg-agent gives a passphrase three tries per request and nothing
limits the next request, so wrong tries are counted here: a SETERROR that
arrives after a GETPIN of the same session is the agent asking again
(language-independent: the text is translated), plus what
passwordstore-action reports with --unlock-failed from gpg's status lines,
since the third try of a request is never reported back. Too many within
the window locks the prompt for an escalating time; GETPIN then shows the
wait and answers "cancelled". passwordstore-action clears the count with
--unlock-ok after a decrypt that worked. State lives in $XDG_RUNTIME_DIR
(never on disk); the policy file next to it is written by
passwordstore-setup lockout-policy from the plugin's settings.

This is a seat lock, not a secret: anything running as the same user can
reset or trip it (the runtime dir is that user's), gpg-agent's passphrase
cache and --pinentry-mode loopback do not pass through here, and another
pinentry-program does not count. It slows guessing at the prompt; the
session lock (policy lockSession) is the backstop for a seat that is not
in its owner's hands.
"""

import json
import os
import socket
import subprocess
import sys
import tempfile
import time

VERSION = "1.0.0"
ERR_CANCELLED = 83886179      # GPG_ERR_CANCELED, source pinentry
ERR_NOT_CONFIRMED = 83886194  # GPG_ERR_NOT_CONFIRMED
ERR_UNKNOWN_CMD = 83886355    # GPG_ERR_ASS_UNKNOWN_CMD
ERR_TIMEOUT = 83886142        # GPG_ERR_TIMEOUT

PLUGIN_DIR = os.path.dirname(os.path.realpath(__file__))

# --- lockout ---------------------------------------------------------------

DEFAULT_POLICY = {"attempts": 5, "windowSec": 600, "lockoutSec": 30, "maxLockoutSec": 1800, "lockSession": False}
POLICY_BOUNDS = {"attempts": (2, 20), "windowSec": (10, 3600), "lockoutSec": (1, 600), "maxLockoutSec": (10, 3600)}
LOCK_SESSION_COMMAND = ["omarchy-system-lock"]


def runtime_dir():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    root = os.path.join(runtime, "pinentry-omarchy")
    os.makedirs(root, mode=0o700, exist_ok=True)
    return root


def read_json(path, fallback):
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else fallback
    except (OSError, ValueError):
        return fallback


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def policy():
    p = dict(DEFAULT_POLICY)
    p.update({k: v for k, v in read_json(os.path.join(runtime_dir(), "policy.json"), {}).items() if k in p})
    return p


def lockout_state():
    return read_json(os.path.join(runtime_dir(), "lockout.json"), {"failures": [], "lockedUntil": 0, "tier": 0})


def save_lockout(state):
    write_json(os.path.join(runtime_dir(), "lockout.json"), state)


def lockout_status(now=None):
    """{locked, remaining, failures, until, tier}."""
    now = time.time() if now is None else now
    p = policy()
    st = lockout_state()
    failures = [t for t in st.get("failures", []) if isinstance(t, (int, float)) and now - t < p["windowSec"]]
    until = float(st.get("lockedUntil", 0) or 0)
    locked = until > now
    return {"locked": locked, "remaining": int(until - now) if locked else 0,
            "failures": len(failures), "until": int(until) if locked else 0, "tier": int(st.get("tier", 0)),
            "attempts": p["attempts"]}


def record_failure():
    """One wrong passphrase. Returns the status afterwards."""
    now = time.time()
    p = policy()
    st = lockout_state()
    failures = [t for t in st.get("failures", []) if isinstance(t, (int, float)) and now - t < p["windowSec"]]
    failures.append(now)
    st["failures"] = failures
    if len(failures) >= p["attempts"] and float(st.get("lockedUntil", 0) or 0) <= now:
        tier = int(st.get("tier", 0))
        seconds = min(p["lockoutSec"] * (4 ** tier), p["maxLockoutSec"])
        st["lockedUntil"] = now + seconds
        st["tier"] = tier + 1
        st["failures"] = []
        if p["lockSession"] and seconds >= p["maxLockoutSec"]:
            # The seat is probably not in its owner's hands. The compositor
            # lock takes the login password, not this prompt, so no loop.
            try:
                subprocess.Popen(LOCK_SESSION_COMMAND, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as e:
                sys.stderr.write("pinentry-omarchy: could not lock the session: %s\n" % e)
    save_lockout(st)
    return lockout_status(now)


def record_success():
    save_lockout({"failures": [], "lockedUntil": 0, "tier": 0})
    return lockout_status()


def format_remaining(seconds):
    seconds = max(0, int(seconds))
    return "%d:%02d" % (seconds // 60, seconds % 60)

PROMPT_QML = os.path.join(PLUGIN_DIR, "pinentry", "shell.qml")
SHELL_DIR = os.path.join(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"), "shell")


def stage_config():
    """A Quickshell config root for the prompt, outside the plugin folder.

    shell.qml imports qs.Commons and qs.Ui, which Quickshell resolves from the
    config root, so the root needs symlinks to the shell's modules; a plugin
    folder may not contain symlinks (omarchy-plugin-validate refuses them),
    hence a staging directory under the runtime dir, refreshed when the
    plugin's copy changes.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    root = os.path.join(runtime, "pinentry-omarchy")
    os.makedirs(root, mode=0o700, exist_ok=True)
    target = os.path.join(root, "shell.qml")
    try:
        if not os.path.exists(target) or os.path.getmtime(target) < os.path.getmtime(PROMPT_QML):
            with open(PROMPT_QML, "rb") as src, open(target, "wb") as dst:
                dst.write(src.read())
    except OSError:
        return PROMPT_QML
    for name in ("Commons", "Ui"):
        link = os.path.join(root, name)
        want = os.path.join(SHELL_DIR, name)
        try:
            if os.path.islink(link) and os.readlink(link) == want:
                continue
            if os.path.lexists(link):
                os.unlink(link)
            os.symlink(want, link)
        except OSError:
            return PROMPT_QML
    return target


def unescape(text):
    """Assuan %XX escapes, in the arguments the agent sends."""
    out = bytearray()
    data = text.encode("utf-8", "surrogateescape")
    i = 0
    while i < len(data):
        if data[i] == 0x25 and i + 2 < len(data):
            try:
                out.append(int(data[i + 1:i + 3], 16))
                i += 3
                continue
            except ValueError:
                pass
        out.append(data[i])
        i += 1
    return out.decode("utf-8", "replace")


def escape(text):
    """The same escapes for what goes back in a D line."""
    return text.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")


def mnemonic(label):
    """gpg-agent's button labels carry a _ before the accelerator letter."""
    return label.replace("__", "\x00").replace("_", "").replace("\x00", "_")


class Pinentry:
    def __init__(self):
        self.reset()
        self.out = sys.stdout

    def reset(self):
        self.asked = False
        self.setting_new = False   # SETREPEAT seen: a new passphrase, not a guess
        self.errors = 0            # SETERRORs after a GETPIN this session
        self.answered = 0          # GETPINs answered this session
        self.errored_since = False # a SETERROR followed the last answer
        self.desc = ""
        self.prompt = "Passphrase:"
        self.title = ""
        self.error = ""
        self.ok = "OK"
        self.cancel = "Cancel"
        self.notok = ""
        self.repeat = ""
        self.repeat_error = "Passphrases do not match"
        self.keyinfo = ""
        self.timeout = 0

    def send(self, line):
        self.out.write(line + "\n")
        self.out.flush()

    # --- the prompt ------------------------------------------------------

    def ask(self, mode, one_button=False):
        """Show the card; returns the result dict or None when cancelled."""
        request = {
            "mode": mode,
            "title": self.title or "Passphrase",
            "description": self.desc,
            "prompt": self.prompt,
            "error": self.error,
            "ok": self.ok,
            "cancel": self.cancel,
            "notok": self.notok,
            "repeat": self.repeat,
            "repeatError": self.repeat_error,
            "oneButton": one_button,
        }
        runtime = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
        sockdir = tempfile.mkdtemp(prefix="pinentry-omarchy.", dir=runtime)
        path = os.path.join(sockdir, "sock")
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            server.bind(path)
            os.chmod(path, 0o600)
            server.listen(1)
            server.settimeout(0.25)
            env = dict(os.environ)
            env["PINENTRY_OMARCHY_SOCKET"] = path
            env["PINENTRY_OMARCHY_REQUEST"] = json.dumps(request)
            self.fill_wayland_env(env)
            hook = env.get("PINENTRY_OMARCHY_PROMPT")
            command = [hook] if hook else ["qs", "-p", stage_config()]
            try:
                proc = subprocess.Popen(command, env=env, stdin=subprocess.DEVNULL,
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                return None
            deadline = time.monotonic() + self.timeout if self.timeout > 0 else None
            data = b""
            conn = None
            while conn is None:
                try:
                    conn, _ = server.accept()
                except socket.timeout:
                    if proc.poll() is not None:
                        return None
                    if deadline and time.monotonic() > deadline:
                        proc.terminate()
                        return {"timeout": True}
            with conn:
                conn.settimeout(None)
                while True:
                    chunk = conn.recv(4096)
                    if not chunk:
                        break
                    data += chunk
            proc.wait(timeout=5) if proc.poll() is None else None
            try:
                result = json.loads(data.decode("utf-8"))
            except ValueError:
                return None
            return result if isinstance(result, dict) else None
        finally:
            server.close()
            try:
                os.unlink(path)
            except OSError:
                pass
            try:
                os.rmdir(sockdir)
            except OSError:
                pass

    @staticmethod
    def fill_wayland_env(env):
        """gpg-agent may have been started without the compositor's display."""
        if env.get("WAYLAND_DISPLAY"):
            return
        runtime = env.get("XDG_RUNTIME_DIR")
        if not runtime:
            return
        try:
            names = sorted(n for n in os.listdir(runtime) if n.startswith("wayland-") and not n.endswith(".lock"))
        except OSError:
            return
        if names:
            env["WAYLAND_DISPLAY"] = names[0]

    # --- commands ---------------------------------------------------------

    def getpin(self):
        status = lockout_status()
        if status["locked"]:
            # Show the wait as a plain message, then tell gpg-agent no.
            saved = (self.desc, self.title)
            self.desc = "Too many wrong passphrases. Try again in %s." % format_remaining(status["remaining"])
            self.title = "Locked"
            self.ask("message", True)
            self.desc, self.title = saved
            self.send("ERR %d Operation cancelled <Pinentry>" % ERR_CANCELLED)
            return
        result = self.ask("getpin")
        if result is None or not result.get("ok"):
            if result and result.get("timeout"):
                self.send("ERR %d Timeout <Pinentry>" % ERR_TIMEOUT)
            else:
                self.send("ERR %d Operation cancelled <Pinentry>" % ERR_CANCELLED)
            return
        pin = str(result.get("pin", ""))
        self.asked = True
        self.answered += 1
        self.errored_since = False
        if self.repeat:
            self.send("S PIN_REPEATED")
        self.send("D " + escape(pin))
        self.send("OK")

    def confirm(self, one_button):
        result = self.ask("confirm", one_button)
        if result is None:
            self.send("ERR %d Operation cancelled <Pinentry>" % ERR_CANCELLED)
        elif result.get("ok"):
            self.send("OK")
        elif result.get("notok"):
            self.send("ERR %d Not confirmed <Pinentry>" % ERR_NOT_CONFIRMED)
        else:
            self.send("ERR %d Operation cancelled <Pinentry>" % ERR_CANCELLED)

    def handle(self, line):
        line = line.rstrip("\r\n")
        if not line or line.startswith("#"):
            return True
        parts = line.split(" ", 1)
        cmd = parts[0].upper()
        arg = unescape(parts[1]) if len(parts) > 1 else ""
        if cmd == "BYE":
            # The agent asks again after a wrong answer and gives up after
            # the third; a session that ends after an answer with no error
            # following it, and fewer than two errors, therefore ended on an
            # accepted passphrase. That covers `pass` in a terminal, which
            # never reports through passwordstore-action. Only when the
            # agent was unwrapping an OpenPGP key (SETKEYINFO n/<keygrip>):
            # a GET_PASSPHRASE or a symmetric decrypt (u/…, --clear) hands
            # back whatever was typed without checking it, and must not
            # count as anything.
            if (self.answered > 0 and not self.errored_since and self.errors < 2
                    and not self.setting_new and self.keyinfo.startswith("n/")):
                record_success()
            self.send("OK closing connection")
            return False
        if cmd == "OPTION":
            name, _, value = arg.partition("=")
            if name == "default-ok":
                self.ok = mnemonic(value)
            elif name == "default-cancel":
                self.cancel = mnemonic(value)
            elif name == "default-prompt":
                self.prompt = value
            self.send("OK")
        elif cmd == "GETINFO":
            what = arg.strip()
            if what == "flavor":
                self.send("D omarchy")
            elif what == "version":
                self.send("D " + VERSION)
            elif what == "pid":
                self.send("D %d" % os.getpid())
            elif what == "ttyinfo":
                self.send("D - - -")
            self.send("OK")
        elif cmd == "SETDESC":
            self.desc = arg; self.send("OK")
        elif cmd == "SETPROMPT":
            self.prompt = mnemonic(arg); self.send("OK")
        elif cmd == "SETTITLE":
            self.title = arg; self.send("OK")
        elif cmd == "SETERROR":
            self.error = arg
            # After a GETPIN of this session an error means the agent is
            # asking again because the answer was wrong ("Bad Passphrase
            # (try 2 of 3)", in whatever language). A repeat mismatch is
            # handled inside the card and never reaches here.
            if self.asked and not self.setting_new:
                record_failure()
                self.errors += 1
                self.errored_since = True
            self.send("OK")
        elif cmd == "SETOK":
            self.ok = mnemonic(arg); self.send("OK")
        elif cmd == "SETCANCEL":
            self.cancel = mnemonic(arg); self.send("OK")
        elif cmd == "SETNOTOK":
            self.notok = mnemonic(arg); self.send("OK")
        elif cmd == "SETREPEAT":
            self.repeat = mnemonic(arg) or "Repeat:"
            self.setting_new = True
            self.send("OK")
        elif cmd == "SETREPEATERROR":
            self.repeat_error = arg; self.send("OK")
        elif cmd == "SETKEYINFO":
            self.keyinfo = arg; self.send("OK")
        elif cmd == "SETTIMEOUT":
            try:
                self.timeout = int(arg)
            except ValueError:
                self.timeout = 0
            self.send("OK")
        elif cmd in ("SETQUALITYBAR", "SETQUALITYBAR_TT", "SETGENPIN", "SETGENPIN_TT",
                     "SETFORMATTEDPASSPHRASE", "SETFORMATTEDPASSPHRASE_TT", "SETCONSTRAINTS", "SETCONSTRAINTS_TT",
                     "SETCAPSLOCK_TT", "SETCF_ACTION_FN", "CLEARPASSPHRASE", "HELP", "NOP", "END", "CANCEL"):
            self.send("OK")
        elif cmd == "RESET":
            self.reset(); self.send("OK")
        elif cmd == "GETPIN":
            self.getpin()
            # gpg-agent sets the error and prompt afresh for every try.
            self.error = ""
            self.repeat = ""
        elif cmd == "CONFIRM":
            self.confirm("--one-button" in arg)
        elif cmd == "MESSAGE":
            self.ask("message", True)
            self.send("OK")
        else:
            self.send("ERR %d Unknown IPC command <Pinentry>" % ERR_UNKNOWN_CMD)
        return True


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--version", "-v"):
        print("pinentry-omarchy " + VERSION)
        return 0
    # The lockout side door for passwordstore-action and -setup; JSON out.
    if len(sys.argv) > 1 and sys.argv[1] == "--lockout-status":
        print(json.dumps(lockout_status()))
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--unlock-failed":
        print(json.dumps(record_failure()))
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--unlock-ok":
        print(json.dumps(record_success()))
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--set-policy":
        # --set-policy '{"attempts":5,...}': unknown keys are dropped.
        try:
            wanted = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
        except ValueError:
            wanted = {}
        p = dict(DEFAULT_POLICY)
        for k in p:
            if k in wanted:
                if isinstance(p[k], bool):
                    p[k] = bool(wanted[k])
                else:
                    lo, hi = POLICY_BOUNDS[k]
                    try:
                        p[k] = min(hi, max(lo, int(wanted[k])))
                    except (TypeError, ValueError):
                        pass
        write_json(os.path.join(runtime_dir(), "policy.json"), p)
        print(json.dumps(p))
        return 0
    entry = Pinentry()
    entry.send("OK Pleased to meet you")
    for line in sys.stdin:
        if not entry.handle(line):
            break
    return 0


if __name__ == "__main__":
    sys.exit(main())
